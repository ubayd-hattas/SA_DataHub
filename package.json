{
  "name": "sa-data-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "python validation/report.py",
    "db:migrate": "node db/migrate.mjs",
    "db:migrate:status": "node db/migrate.mjs --status",
    "db:seed:generate": "node db/scripts/generate_seed.mjs",
    "db:inspect": "node db/scripts/inspect.mjs",
    "db:reset": "node db/scripts/reset_dev.mjs",
    "etl": "python etl/run.py",
    "etl:verify": "node etl/verify.mjs",
    "test": "vitest run",
    "test:equivalence": "vitest run tests/equivalence",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.383.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-scrollama": "^2.4.2",
    "recharts": "^2.12.7",
    "simple-statistics": "^7.10.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
